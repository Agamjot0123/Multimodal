# ---------- Server ----------
PORT=8000

# ---------- LLM providers ----------
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# ---------- Supabase (database) ----------
# Supabase dashboard → Project Settings → API
SUPABASE_URL="https://your-project.supabase.co"
# Use the `service_role` secret key, NOT the `anon` key. Backend only: never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# ---------- Auth ----------
# Must be IDENTICAL to JWT_SECRET on the auth server. Generate with: openssl rand -hex 32
JWT_SECRET="your_jwt_secret_here"

# ---------- CORS ----------
# localhost:3000 is always allowed. Add your deployed frontend origin(s), comma-separated, no trailing slash.
# e.g. https://anchorlearn.vercel.app
FRONTEND_ORIGINS=""
