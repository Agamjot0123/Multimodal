# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared with the backend (must be identical). Generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=4000
SERVER_URL=http://localhost:4000
# Comma-separated allowed frontend origins; the first one receives the login redirect.
FRONTEND_URL=http://localhost:3000
