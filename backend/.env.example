# Server Config
PORT=8000

# LLM Provider API Keys
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase (database only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"  # backend only, never expose to the frontend


# Must match the auth server's JWT_SECRET (openssl rand -hex 32)
JWT_SECRET="change-me"
# Production frontend origin(s), comma-separated, e.g. https://studymate.vercel.app
FRONTEND_ORIGINS=""
