# ---------- Google OAuth ----------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI must be exactly: <SERVER_URL>/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---------- Tokens ----------
# Must be IDENTICAL to JWT_SECRET on the backend. Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ---------- URLs ----------
# This server's own public URL, no trailing slash.
#   local:      http://localhost:4000
#   production: https://your-auth.onrender.com
SERVER_URL=http://localhost:4000
# Allowed frontend origin(s), comma-separated, no trailing slash. The first one receives the login redirect.
#   local:      http://localhost:3000
#   production: https://your-app.vercel.app  (add http://localhost:3000 too if you test locally against production)
FRONTEND_URL=http://localhost:3000

# Render sets PORT automatically; only needed locally.
PORT=4000
