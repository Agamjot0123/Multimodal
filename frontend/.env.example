# Restart `npm run dev` (or redeploy) after changing these: NEXT_PUBLIC_* values are baked in at build time.

# Backend base URL, no trailing slash.
#   local:      http://localhost:8000
#   production: https://your-backend.onrender.com
# Leave empty to use the built-in mock chat/quiz routes (communities are disabled).
NEXT_PUBLIC_API_BASE_URL=

# Auth server URL, no trailing slash.
#   local:      http://localhost:4000
#   production: https://your-auth.onrender.com
# Leave empty to skip login entirely.
NEXT_PUBLIC_AUTH_URL=
